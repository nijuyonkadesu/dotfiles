    <Value>2.99834990501404</Value>
   </Parameter>

   <Parameter>
    <Index>30</Index>
    <Name>Release</Name>
    <Symbol>rt</Symbol>
    <Value>250</Value>
   </Parameter>

   <Parameter>
    <Index>31</Index>
