 <!-- Noise repellent -->
 <Plugin>
  <Info>
   <Type>LV2</Type>
   <Name>Noise repellent</Name>
   <URI>https://github.com/lucianodato/noise-repellent-stereo#new</URI>
  </Info>

  <Data>
   <Active>Yes</Active>
   <ControlChannel>1</ControlChannel>
   <Options>0x1</Options>

   <Parameter>
